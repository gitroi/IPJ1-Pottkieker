@startuml Prognose_Speicher
/'
Grundstruktur mit Hilfe von KI anhand Python-Code erstellt. (Claude Sonnet 4.5)
'/

<style>
activity {
    HorizontalAlignment center
}
</style>

start

:Fixparameter für alle Speicherarten einlesen;



:Gesamt-Ausbauprognose erstellen;

note right
Funktionen nutzen 
Fix- und Szenariodaten
(Linearer Ausbau bis
jeweils 2030/2045)
end note

:Erzeugungs- und Verbrauchsprognosenergebnisse einlesen\n(Dataframes zusammenfügen);

:Anfangs-Ladestand setzen;

partition "Schleife über alle Zeitpunkte (15 min Auflösung)" {
    
    :Momentanleistungen und verfügbare Ladung berechnen;
    
    :Summe EE-Erzeuger berechnen;
    
    if (Anteil EE > Ladegrenze?) then (ja)
        :Überschüssige Energie berechnen;
        
        :Speicher nacheinander laden\n(Batterie → Schwungrad → Wasserstoff → Pumpspeicher);
        
        note right
            Pro Speicher:
            - Prüfe Ladestand
            - Lade max. Leistung/4 (15min)
            - Lade max. bis Obergrenze
            - Restenergie → "Export"
        end note
        
    elseif (Anteil EE ≤ Entladegrenze?) then (ja)
        :Fehlende Energie berechnen;
        
        :Speicher nacheinander entladen\n(Batterie → Schwungrad → Wasserstoff → Pumpspeicher);
        
        note right
            Pro Speicher:
            - Prüfe Ladestand
            - Entlade max. Leistung/4 (15min)
            - Entlade max. bis Untergrenze
            - Berücksichtige Wirkungsgrad
            - Restbedarf → "Import"
        end note
        
    endif
    
    :Speicherstände und "extra" Energie in Listen speichern;
    
}

:Listen als neue Spalten dem Dataframe hinzufügen;

:Return Dataframe;

stop
@enduml