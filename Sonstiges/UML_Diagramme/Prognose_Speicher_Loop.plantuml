@startuml Prognose_Speicher_Loop
/'
Grundstruktur mit Hilfe von KI anhand Python-Code erstellt. (Claude Sonnet 4.5)
'/

<style>
activity {
    HorizontalAlignment center
}
</style>

start

partition "Schleife über alle Zeitpunkte (15 min Auflösung)" {
    
    :Momentanleistungen und verfügbare Ladung berechnen;
    
    :Summe EE-Erzeuger berechnen;
    
    if (Anteil EE > Ladegrenze?) then (ja)
        :Überschüssige Energie berechnen;
        
        :Speicher nach Priorität laden:
        • Prüfe Ladestand
        • Lade max. Leistung/4 (15min)
        • Lade max. bis Obergrenze
        • Output-Wirkungsgrad
        • Restenergie → "Export";
        
    elseif (Anteil EE ≤ Entladegrenze?) then (ja)
        :Fehlende Energie berechnen;
        
        :Speicher nacheinander entladen
        (Batterie → Pumpspeicher → Wasserstoff):
        • Prüfe Ladestand
        • Entlade max. Leistung/4 (15min)
        • Entlade max. bis Untergrenze
        • Output-Wirkungsgrad
        • Restbedarf → "Import"/Konventionelle;
        
    endif
    
    :Speicherstände und "extra" Energien in Listen speichern;
    
}

stop
@enduml